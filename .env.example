# Copy this file to .env and fill in the keys you actually have.
# Every integration is optional -- the system degrades gracefully (dry-run /
# mock mode) when a key is missing, it just discovers/enriches less.

# --- Search provider -------------------------------------------------------
# Used by providers/search_provider.py for all web-discovery query execution
# (state/city search, community discovery, founder/marketer discovery, etc.)
# Supported backends: "serpapi", "google_cse", "bing", "none"
SEARCH_PROVIDER_BACKEND=none
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_CSE_ID=
SEARCH_PROVIDER_RPS=1

# --- Contact enrichment providers ------------------------------------------
HUNTER_API_KEY=
HUNTER_ENABLED=false
HUNTER_MONTHLY_CREDIT_LIMIT=100

APOLLO_API_KEY=
APOLLO_ENABLED=false
APOLLO_MONTHLY_CREDIT_LIMIT=100

# --- Runtime -----------------------------------------------------------------
DRY_RUN=true
LOG_LEVEL=INFO
CACHE_DIR=.cache
CHECKPOINT_DIR=.checkpoints
