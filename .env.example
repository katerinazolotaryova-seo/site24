# Copy to .env and fill in. Never commit the real .env file.
# See analyzer/config.py for the full list of settings and their defaults.

# Postgres started via `docker compose up` (docker-compose.yml).
ANALYZER_DATABASE_URL=postgresql+psycopg://analyzer:analyzer@localhost:5432/analyzer

# DataForSEO (see docs/seo-presale-analyzer/ARCHITECTURE_AND_MVP_PLAN.md §11)
ANALYZER_DATAFORSEO_LOGIN=
ANALYZER_DATAFORSEO_PASSWORD=

# Anthropic Claude (LLM interpretation layer, Phase 3.5+)
ANALYZER_ANTHROPIC_API_KEY=

# Per-project API budget ceiling, USD (see plan §10.2 — agreed default: 8.00)
ANALYZER_DEFAULT_API_BUDGET_USD=8.00

ANALYZER_LOG_LEVEL=INFO
