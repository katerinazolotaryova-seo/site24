# Доступы и ключи проекта site24 / Bettertone
# ШАБЛОН — коммитится в git, реальных значений не содержит.
# Реальные значения — в файле .env (он в .gitignore и никогда не пушится).
#
# Как пользоваться:
#   1) cp .env.example .env
#   2) заполнить .env реальными значениями
#   3) появился новый сервис — сначала добавь переменную сюда (в шаблон), потом в .env

# --- ХОСТИНГ / СЕРВЕР ---------------------------------------------
HOSTING_PROVIDER=
HOSTING_PANEL_URL=
HOSTING_LOGIN=
HOSTING_PASSWORD=
HOSTING_SSH_HOST=
HOSTING_SSH_USER=
HOSTING_SSH_KEY_PATH=

# --- ДОМЕН ----------------------------------------------------------
DOMAIN_REGISTRAR=
DOMAIN_LOGIN=
DOMAIN_PASSWORD=
DOMAIN_DNS_PANEL_URL=

# --- CMS / САЙТ (WordPress и т.п.) -----------------------------------
CMS_ADMIN_URL=
CMS_LOGIN=
CMS_PASSWORD=
FTP_HOST=
FTP_LOGIN=
FTP_PASSWORD=

# --- GITHUB -----------------------------------------------------------
GITHUB_ORG=
GITHUB_PAT_NAME=
# сам токен сюда не пишем текстом "просто так" без необходимости —
# если он нужен локально, кладём значение только в .env, не в .env.example

# --- GOOGLE (Search Console, Analytics, Ads, Business Profile) --------
GOOGLE_ACCOUNT=
GOOGLE_SEARCH_CONSOLE_SITE=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_BUSINESS_PROFILE_ACCESS=

# --- ЯНДЕКС (Вебмастер, Метрика, Директ) -------------------------------
YANDEX_ACCOUNT=
YANDEX_WEBMASTER_SITE=
YANDEX_METRIKA_COUNTER_ID=
YANDEX_DIRECT_LOGIN=

# --- ПОЧТА / РАССЫЛКИ ---------------------------------------------------
MAIL_SERVICE=
MAIL_LOGIN=
MAIL_PASSWORD=

# --- AHREFS -------------------------------------------------------------
AHREFS_API_KEY=

# --- DATAFORSEO -----------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- SEO / ДРУГИЕ ИНСТРУМЕНТЫ (Serpstat, Screaming Frog и т.п.) ----------
SEO_TOOL_NAME=
SEO_TOOL_LOGIN=
SEO_TOOL_API_KEY=

# --- ПРОЧЕЕ --------------------------------------------------------------
