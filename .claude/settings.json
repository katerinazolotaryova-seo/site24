{
  "permissions": {
    "allow": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git remote*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(git push*)"
    ]
  }
}